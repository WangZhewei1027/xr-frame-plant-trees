<view class="page">
  <view class="title">小程序场景联调</view>
  <view class="hint">真实 Three.js / GLB 加载器 / 场景播放器 · 模拟相机，无 VisionKit</view>
  <input aria-label="场景 ID" placeholder="场景 ID" value="{{sceneId}}" bindinput="onSceneInput" />
  <input aria-label="团队 ID" placeholder="团队 ID" value="{{organizationId}}" bindinput="onOrganizationInput" />
  <button size="mini" disabled="{{!enabled || busy}}" bindtap="loadScene">加载并自动验证</button>
  <view class="status">{{status}}</view>
  <canvas id="scene-canvas" type="webgl2" style="width:100%;height:340px" bindtouchend="togglePlayback" bindwebglcontextlost="onContextLost" />
  <view class="controls">
    <button size="mini" disabled="{{!loaded || busy}}" bindtap="togglePlayback">暂停 / 继续</button>
    <button size="mini" disabled="{{!loaded || busy}}" bindtap="restart">重播</button>
    <button size="mini" disabled="{{!loaded || busy}}" bindtap="clearScene">清场</button>
  </view>
  <view class="hint">{{playback}}</view>
  <view class="report" selectable="true">{{report}}</view>
  <view class="hint">这里验证小程序真实播放代码；相机追踪、平面检测和手机性能仍需真机。</view>
</view>
