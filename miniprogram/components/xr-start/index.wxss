:host { display:block; width:100%; height:100%; }
.ar-renderer { width:100%;height:100%;position:relative;background:#14202b; }
.ar-canvas { width:100%;height:100%; }
.ar-message { position:absolute;top:35%;left:24px;right:24px;padding:20px;background:rgba(10,18,28,.85);color:#fff;border-radius:12px;text-align:center;font-size:14px; }
.ar-message text { display:block;line-height:1.6;margin-bottom:12px; }
