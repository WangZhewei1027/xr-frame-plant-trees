page { background: #f3f5f7; color: #17212b; }
.page { padding: 16px; padding-bottom: 40px; }
.title { display: block; font-size: 21px; font-weight: 600; margin-bottom: 8px; }
.description, .hint { display: block; font-size: 12px; line-height: 1.6; color: #526273; margin: 8px 0; }
.viewport { position: relative; overflow: hidden; border-radius: 12px; background: #14202b; }
.badge { position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,.65); color: white; font-size: 12px; padding: 5px 8px; border-radius: 5px; pointer-events: none; }
.crosshair { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 28px; color: #fff; pointer-events: none; }
.status { display: block; font-size: 14px; line-height: 1.6; margin: 12px 0; }
.section { margin-top: 16px; padding: 12px; background: #fff; border-radius: 10px; }
.label { display: block; font-weight: 600; font-size: 15px; margin-bottom: 12px; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; }
.actions button { margin: 0; }
.report { display: block; white-space: pre-wrap; word-break: break-all; font-size: 11px; line-height: 1.6; margin: 10px 0; }
