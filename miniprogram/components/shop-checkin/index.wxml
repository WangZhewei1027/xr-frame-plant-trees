<!-- 导航方向覆层 -->
<view class="nav-overlay" wx:if="{{isNavigating}}">
  <view class="nav-compass-ring">
    <view class="nav-arrow-wrap" style="transform: rotate({{navRelAngle}}deg)">
      <view class="nav-arrow-head"></view>
      <view class="nav-arrow-tail"></view>
    </view>
  </view>
  <view class="nav-info-row">
    <text class="nav-shop-name">{{navShopName}}</text>
    <text class="nav-dist">{{navDistance}}</text>
  </view>
</view>

<!-- 打卡成功弹窗 -->
<view class="checkin-mask" wx:if="{{showCheckinModal}}" bindtap="closeCheckinModal">
  <view class="checkin-modal" catchtap="">
    <text class="checkin-modal-title">{{checkinShopName}} · 打卡成功</text>
    <image wx:if="{{checkinImageUrl}}" class="checkin-modal-img" src="{{checkinImageUrl}}" mode="aspectFit" />
    <view class="checkin-modal-actions">
      <view wx:if="{{checkinImageUrl}}" class="checkin-save-btn" bindtap="saveCheckinImage">保存到相册</view>
      <view class="checkin-close-btn" bindtap="closeCheckinModal">关闭</view>
    </view>
  </view>
</view>

<!-- 店铺卡片列表 -->
<view class="shop-swiper-wrap" wx:if="{{visible}}">
  <picker wx:if="{{activities.length > 1}}" range="{{activities}}" range-key="display_name" value="{{selectedActivityIdx}}" disabled="{{!!submittingPointId}}" bindchange="onActivityChange" aria-label="选择店铺打卡活动">
    <view class="shop-activity-picker">{{activeActivity.display_name}} · 切换活动</view>
  </picker>
  <text wx:else class="shop-activity-title">{{activeActivity.display_name}}</text>
  <view class="shop-progress" wx:if="{{shops.length > 0}}">
    <text class="shop-progress-text">{{checkedInCount}}/{{shops.length}} 已打卡</text>
  </view>
  <button wx:if="{{progressError}}" class="shop-progress-retry" bindtap="loadProgress">{{progressError}}</button>
  <block wx:if="{{shopsLoading}}">
    <view class="shop-loading">加载中…</view>
  </block>
  <block wx:elif="{{shops.length === 0}}">
    <view class="shop-loading">此活动暂无打卡点</view>
  </block>
  <swiper
    wx:else
    class="shop-swiper"
    previous-margin="60rpx"
    next-margin="60rpx"
    current="{{selectedShopIdx}}"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{shops}}" wx:key="id">
      <view class="shop-card {{selectedShopIdx === index ? 'selected' : ''}}">
        <image wx:if="{{item.image_url}}" class="shop-card-img" src="{{item.image_url}}" mode="aspectFill" />
        <view class="shop-card-right">
          <text class="shop-card-name">{{item.name}}</text>
          <text class="shop-card-desc">{{item.description}}</text>
          <view class="shop-card-bottom">
            <text class="shop-card-dist" wx:if="{{item.distance !== undefined}}">📍 {{item.distance}}m</text>
            <text class="shop-card-dist" wx:else>{{item.hasLocation ? '📍 定位中…' : '未设置位置'}}</text>
            <view
              class="shop-checkin-btn {{checkedPointIds[item.point_id] ? 'checked-in' : (item.canCheckin ? 'active' : 'disabled')}}"
              bindtap="onCheckin"
              data-idx="{{index}}"
              aria-role="button"
              aria-label="{{item.name}}打卡"
              aria-disabled="{{!!submittingPointId || (!checkedPointIds[item.point_id] && !item.canCheckin)}}"
            >
              {{submittingPointId === item.id ? '提交中…' : checkedPointIds[item.point_id] ? '已打卡' : (item.canCheckin ? '打卡' : '无法打卡')}}
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>
