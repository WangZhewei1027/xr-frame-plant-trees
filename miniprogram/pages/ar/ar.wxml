<view class="page-container">
  <!-- AR 底层画布 -->

  <!-- 顶部 Logo 叠层 -->
  <image wx:if="{{footerEnabled}}" class="ar-top-logo" src="/assets/DHL-Outlined.png" mode="aspectFit" />

  <xr-start
    disable-scroll
    id="main-frame"
    width="{{renderWidth}}"
    height="{{renderHeight}}"
    style="width:{{width}}px;height:{{height}}px;"
    bind:orgconfigload="onOrgConfigLoad"
    bind:recognitionstatus="onRecognitionStatus"
    bind:recognitionframe="onRecognitionFrame"
    bind:asseterror="onAssetError"
  />

  <!-- ===== 底部区域 ===== -->
  <view class="bottom-area">

    <!-- 店铺打卡组件（导航覆层 + 打卡弹窗 + 店铺列表） -->
    <block wx:if="{{shopCheckinEnabled}}">
      <shop-checkin
        id="shop-checkin"
        visible="{{showShopPanel}}"
        location="{{location}}"
        compass-heading="{{compassHeading}}"
        bind:navchange="onShopNavChange"
      />
    </block>

    <view class="retrieval-panel">
      <view class="retrieval-switch">
        <button class="retrieval-option {{retrievalMode === 'gps' ? 'is-active' : ''}}" data-mode="gps" bindtap="onRetrievalModeChange" aria-label="GPS 直接过滤">GPS 直接过滤</button>
        <button class="retrieval-option {{retrievalMode === 'anchor' ? 'is-active' : ''}}" data-mode="anchor" bindtap="onRetrievalModeChange" aria-label="匹配点识别">匹配点识别</button>
      </view>
      <text class="retrieval-status">{{retrievalMode === 'gps' ? '根据附近位置直接显示素材' : recognitionStatus}}</text>
      <button wx:if="{{retrievalMode === 'anchor'}}" class="recognition-preview-button" disabled="{{!recognitionFramePath}}" bindtap="onPreviewRecognitionFrame">查看识别画面</button>
    </view>

    <!-- 弹幕输入栏（始终可见） -->
    <view class="danmaku-bar">

      <!-- GPS 调试小窗（点灯泡开关） -->
      <view wx:if="{{showGpsDebug}}" class="gps-debug-pop">
        <block wx:if="{{location}}">
          <view class="gps-debug-row"><text class="gps-debug-label">纬度</text>{{location.latStr}}</view>
          <view class="gps-debug-row"><text class="gps-debug-label">经度</text>{{location.lngStr}}</view>
          <view class="gps-debug-row"><text class="gps-debug-label">精度</text>{{location.accuracyStr}}</view>
          <view class="gps-debug-row"><text class="gps-debug-label">海拔</text>{{location.altitudeStr}}</view>
        </block>
        <view wx:else class="gps-debug-row">暂无 GPS 信号</view>
      </view>

      <view class="gps-dot-tap" bindtap="toggleGpsDebug">
        <view class="gps-dot {{location ? 'gps-ok' : 'gps-fail'}}"></view>
      </view>
      <input
        class="danmaku-input"
        placeholder="发个弹幕到AR世界~"
        value="{{textContent}}"
        bindinput="onTextInput"
        maxlength="200"
        confirm-type="send"
        bindconfirm="submitText"
      />
      <view
        class="danmaku-send {{canSubmit ? 'active' : ''}}"
        bindtap="submitText"
      >
        <image class="send-icon" src="/assets/send.svg" mode="aspectFit" />
      </view>
      <view wx:if="{{shopCheckinEnabled}}" class="bar-divider"></view>
      <view wx:if="{{shopCheckinEnabled}}" class="shop-toggle {{showShopPanel ? 'shop-toggle-on' : ''}}" bindtap="toggleShopPanel">
        <image class="shop-toggle-icon" src="/assets/circle-check-big.svg" mode="aspectFit" />
      </view>
    </view>

  </view>
  <view wx:if="{{showRecognitionPreview}}" class="recognition-preview" aria-role="dialog" aria-label="识别画面预览">
    <view class="recognition-preview-heading">
      <text class="recognition-preview-title">实际上传画面</text>
      <text class="recognition-preview-hint">识别已暂停。检查图片是否旋转、偏色，以及是否与参考图内容一致。</text>
    </view>
    <image class="recognition-preview-image" src="{{recognitionFramePath}}" mode="aspectFit" show-menu-by-longpress="{{true}}" binderror="onRecognitionPreviewError" aria-label="最近一张已完成识别的原始上传图片" />
    <view class="recognition-preview-footer">
      <text class="recognition-preview-info">{{recognitionFrameInfo}}</text>
      <text class="recognition-preview-request">请求 {{recognitionFrameRequest}}</text>
      <button class="recognition-preview-close" bindtap="onCloseRecognitionPreview">关闭并继续识别</button>
    </view>
  </view>
</view>
